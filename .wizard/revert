#!/usr/bin/env bash
#
# Undoes setup: removes its symlinks from ~ and restores the backed-up files.
#
# Usage: .wizard/revert

source "$(dirname "$0")/lib"

unlinks=""

# Removes a file's symlink from ~ and restores its backup (skips if not linked)
revert() {
  linked || return 0
  local note=""

  rm "$dst"

  if exists "$bak"; then
    mv "$bak" "$dst"
    note=" (restored)"
  fi

  unlinks+=$'\n'"- ~/$f$note"
}

# Run revert on every repo file
each revert

# Print summary
[ -z "$unlinks" ] || block "🔗 Unlinked:$unlinks"
